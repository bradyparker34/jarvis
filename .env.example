# Copy to .env and adjust. .env is gitignored; keep it that way.

DATABASE_URL=postgresql://jarvis:jarvis_local_dev@127.0.0.1:5464/jarvis

# Embeddings. 'local' runs all-MiniLM-L6-v2 on your CPU with no API key and no
# data leaving the machine. 'openai' is better quality but sends text to OpenAI,
# which defeats part of the point. 'none' disables semantic search; keyword
# search still works.
#
# On anything but 'local', `jarvis embed` refuses to run while confidential,
# restricted or unshareable-space rows are waiting, and your search queries
# are still sent to the provider on every recall. See docs/RISKS.md.
EMBED_PROVIDER=local
EMBED_MODEL=all-MiniLM-L6-v2
# OPENAI_API_KEY=

# HTTP bridge, for agents that cannot speak stdio MCP. Localhost only.
JARVIS_HTTP_PORT=8787
# Any agent reaching the HTTP bridge must send this as a Bearer token.
# Generate with: openssl rand -hex 32
JARVIS_HTTP_TOKEN=

# --- adapters (fill in only what you connect) ---

# Telegram: get api_id/api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Slack user token (xoxp-). Read your employer's policy first.
SLACK_USER_TOKEN=

# Gmail: path to an OAuth client json from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKEN_PATH=.secrets/google-token.json
